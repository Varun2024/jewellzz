{
  "name": "jewelzz",
  "version": "0.0.1",
  "private": true,
  "description": "Offline jewellery shop management",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "postinstall": "node scripts/ensure-native.mjs",
    "dev": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "start": "concurrently -k \"pnpm dev\" \"wait-on http://localhost:5173 && pnpm dev:electron\"",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "pnpm build:renderer && pnpm build:electron",
    "package": "pnpm build && electron-builder",
    "migrate:run": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "better-sqlite3": "^11.7.0",
    "bwip-js": "^4.5.1",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.13.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
